{
  "manifest_version": 3,
  "name": "Steam Notion Scraper",
  "version": "1.0.0",
  "description": "Scraper de páginas de jogos da Steam que envia dados para o Notion.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.notion.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://store.steampowered.com/app/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Steam Notion Scraper"
  }
}
