{
  "manifest_version": 3,
  "name": "Notoo",
  "version": "0.0.1",
  "description": "Capture dados de páginas e envie diretamente para seu banco no Notion. Prático, rápido e integrado ao seu fluxo.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.notion.com/*"],
  "content_scripts": [
    {
      "matches": ["https://store.steampowered.com/app/*", "http://store.steampowered.com/app/*"],
      "js": ["content/content.js"]
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Notoo"
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/*"],
      "matches": ["https://store.steampowered.com/*", "http://store.steampowered.com/*"]
    }
  ]
}
