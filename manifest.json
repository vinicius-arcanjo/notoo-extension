{
  "manifest_version": 3,
  "name": "Notoo",
  "version": "0.0.1",
  "description": "Capture dados de páginas e envie diretamente para seu banco no Notion. Prático, rápido e integrado ao seu fluxo.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.notion.com/*"],
  "content_scripts": [
    {
      "matches": ["*://store.steampowered.com/app/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Notoo"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*", "content.css"],
      "matches": ["*://store.steampowered.com/app/*"]
    }
  ],
  "options_page": "options.html"
}
